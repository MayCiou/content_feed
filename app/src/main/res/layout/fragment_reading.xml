<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/layoutWeatherCard"
        layout="@layout/weather_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWeatherLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutWeatherCard"
        app:layout_constraintEnd_toEndOf="@id/layoutWeatherCard"
        app:layout_constraintStart_toStartOf="@id/layoutWeatherCard"
        app:layout_constraintTop_toTopOf="@id/layoutWeatherCard"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2E7D32">

            <View
                android:id="@+id/viewWeatherLoadingGradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/weather_loading_gradient" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutWeatherCard">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReadingContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/article_item" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Articles Initial Shimmer Loading Overlay -->
    <FrameLayout
        android:id="@+id/layoutArticlesLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutWeatherCard"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <include layout="@layout/item_article_shimmer" />
            <include layout="@layout/item_article_shimmer" />
            <include layout="@layout/item_article_shimmer" />
            <include layout="@layout/item_article_shimmer" />
        </LinearLayout>

        <View
            android:id="@+id/viewArticlesLoadingGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/weather_loading_gradient" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>